# Supabase Project Configuration
# انسخ هذا الملف إلى .env.local وأدخل بيانات مشروع Supabase الحقيقية
# (ملف .env.local مستثنى تلقائيًا من Git عبر .gitignore)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Self-hosted OTA & APK release manifest base URL (e.g. https://<username>.github.io/<repo>/updates)
VITE_UPDATES_BASE_URL=
VITE_APP_CHANNEL=production

