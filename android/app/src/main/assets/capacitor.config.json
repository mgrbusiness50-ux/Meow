{
	"appId": "com.meow.app",
	"appName": "Meow",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#FFF9E9"
	},
	"plugins": {
		"CapacitorUpdater": {
			"autoUpdate": false,
			"resetWhenUpdate": true,
			"autoDeleteFailed": true,
			"autoDeletePrevious": true,
			"appReadyTimeout": 10000,
			"httpsOnly": true,
			"statsUrl": "",
			"defaultChannel": "production"
		}
	}
}
